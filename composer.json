{
    "name": "crabphp/redis",
    "description": "Redis for the Crab framework: a cache store and a queue store that wait without holding a worker",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "crabphp/framework": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "carthage-software/mago": "^1.57.0"
    },
    "autoload": {
        "psr-4": {
            "Crab\\Redis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crab\\Redis\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "format": "@php vendor/bin/mago fmt",
        "format:check": "@php vendor/bin/mago fmt --check",
        "lint": "@php vendor/bin/mago lint"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
